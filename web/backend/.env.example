# Quotation Reader Web — optional defaults (UI Settings can override these)
HOST=127.0.0.1
PORT=8000

# Extra CORS origins (comma-separated). https://crm.impexnine.com is already allowed by default.
# CORS_ORIGINS=https://other.example.com

# Seeded into the app once (then change from Settings page)
IMAP_HOST=mail.impexnine.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FORWARD_WEBHOOK_URL=

# Optional: pre-set login password (otherwise create it on first open /setup)
APP_PASSWORD=

DATABASE_PATH=data/quotation_reader.db
